{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(python .claude/skills/csc-filer/tools/*)",
      "Bash(python3 .claude/skills/csc-filer/tools/*)",
      "Bash(python data/periods/*)",
      "Bash(python3 data/periods/*)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npm install)",
      "Bash(npx playwright install chromium)",
      "Bash(npx playwright install --dry-run chromium)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Read(.csc_profile/**)",
      "Read(.env)"
    ]
  }
}
